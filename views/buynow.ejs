<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>BeBar - Checkout</title>
  <style>
    /* General Reset */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: url("https://themes.muffingroup.com/be/bar/wp-content/uploads/2015/02/home_bar_bg.png") repeat center center;
      min-height: 100vh;
      color: #2c1810;
      line-height: 1.6;
    }

    /* Header */
    .header {
      background: #6b4423;
      backdrop-filter: blur(10px);
      color: #2c1810;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 20px 50px;
      box-shadow: 0 2px 20px rgba(0,0,0,0.1);
    }

    .header .logo {
      font-size: 28px;
      font-weight: bold;
      background: white;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .header .nav-links a {
      color: white;
      text-decoration: none;
      margin-left: 30px;
      font-weight: 500;
      transition: all 0.3s ease;
      position: relative;
    }
    
    .header .nav-links a:after {
      content: '';
      position: absolute;
      bottom: -5px;
      left: 0;
      width: 0;
      height: 2px;
      background: linear-gradient(135deg, #8d6e63 0%, #5d4037 100%);
      transition: width 0.3s ease;
    }

    .header .nav-links a:hover:after {
      width: 100%;
    }

    /* Checkout Container */
    .checkout-container {
      width: 90%;
      max-width: 1000px;
      margin: 40px auto;
      background: rgba(255, 255, 255, 0.98);
      padding: 40px;
      border-radius: 20px;
      box-shadow: 0 20px 60px rgba(0,0,0,0.3);
    }

    .checkout-container h1 {
      text-align: center;
      margin-bottom: 30px;
      font-size: 36px;
      background: linear-gradient(135deg, #6b4423 0%, #3e2723 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    /* Cart */
    .cart {
      margin-bottom: 40px;
    }

    .cart h2 {
      margin-bottom: 20px;
      font-size: 24px;
      color: #3e2723;
      padding-bottom: 10px;
      border-bottom: 3px solid #8d6e63;
    }

    .cart-item {
      display: flex;
      align-items: center;
      margin-bottom: 20px;
      padding: 20px;
      background: linear-gradient(135deg, #f5f0ec 0%, #d7ccc8 100%);
      border-radius: 15px;
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .cart-item:hover {
      transform: translateY(-5px);
      box-shadow: 0 10px 30px rgba(109, 68, 35, 0.3);
    }

    .cart-item img {
      width: 100px;
      height: 100px;
      border-radius: 15px;
      margin-right: 25px;
      object-fit: cover;
      box-shadow: 0 5px 15px rgba(0,0,0,0.2);
    }

    .item-details {
      flex-grow: 1;
    }

    .item-name {
      font-weight: bold;
      font-size: 18px;
      color: #2c1810;
      margin-bottom: 5px;
    }

    .item-price {
      color: #6b4423;
      font-size: 20px;
      font-weight: 600;
      margin-top: 5px;
    }

    .item-qty {
      font-size: 14px;
      color: #5d4037;
      background: #fff;
      padding: 8px 15px;
      border-radius: 20px;
      font-weight: 500;
    }

    /* Summary */
    .summary {
      background: linear-gradient(135deg, #6b4423 0%, #3e2723 100%);
      color: #fff;
      padding: 30px;
      border-radius: 15px;
      box-shadow: 0 10px 30px rgba(109, 68, 35, 0.4);
    }

    .summary h2 {
      margin-bottom: 20px;
      font-size: 24px;
      color: #fff;
    }

    .summary p {
      display: flex;
      justify-content: space-between;
      margin: 12px 0;
      font-size: 16px;
    }

    .summary .total {
      font-weight: bold;
      font-size: 24px;
      border-top: 2px solid rgba(255,255,255,0.3);
      padding-top: 15px;
      margin-top: 15px;
    }

    /* Place Order Button */
    .place-order {
      display: block;
      width: 100%;
      padding: 18px;
      margin-top: 25px;
      background: linear-gradient(135deg, #8d6e63 0%, #5d4037 100%);
      color: #fff;
      font-size: 18px;
      font-weight: bold;
      border: none;
      border-radius: 50px;
      cursor: pointer;
      transition: all 0.3s ease;
      box-shadow: 0 10px 30px rgba(93, 64, 55, 0.4);
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .place-order:hover {
      transform: translateY(-3px);
      box-shadow: 0 15px 40px rgba(93, 64, 55, 0.6);
      background: linear-gradient(135deg, #a1887f 0%, #6d4c41 100%);
    }

    .place-order:active {
      transform: translateY(-1px);
    }

    /* Footer */
    .footer {
      text-align: center;
      margin-top: 50px;
      padding: 30px;
      background: rgba(255, 255, 255, 0.95);
      color: #3e2723;
      font-size: 14px;
      backdrop-filter: blur(10px);
    }

    .footer p {
      margin: 8px 0;
    }

    .footer a {
      color: #6b4423;
      text-decoration: none;
      margin: 0 10px;
      font-weight: 500;
      transition: color 0.3s ease;
    }

    .footer a:hover {
      color: #8d6e63;
    }

    /* Responsive */
    @media (max-width: 768px) {
      .header {
        padding: 15px 20px;
      }

      .header .logo {
        font-size: 24px;
      }

      .header .nav-links a {
        margin-left: 15px;
        font-size: 14px;
      }

      .checkout-container {
        padding: 25px;
      }

      .checkout-container h1 {
        font-size: 28px;
      }

      .cart-item {
        flex-direction: column;
        text-align: center;
      }

      .cart-item img {
        margin: 0 0 15px 0;
      }

      .item-qty {
        margin-top: 10px;
      }
    }
  </style>
</head>
<body>
  <div class="header">
    <div class="logo">BeBar</div>
    <div class="nav-links">
      <a href="/">Home</a>
      <a href="/contact">Contact</a>
    </div>
  </div>

    <div class="checkout-container">
    <h1>🛒 Your Cart</h1>
    <div class="cart">
      <h2>Items in Cart</h2>

      <!-- Red Wine -->
      <div class="cart-item">
        <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRaYem1r7BlmZeUjnfLHtqKQMaqy9EbG0-kHA&s" alt="Red Wine">
        <div class="item-details">
          <p class="item-name">Premium Red Wine</p>
          <p class="item-price">$100.00</p>
        </div>
        <p class="item-qty">Qty: 1</p>
      </div>

      <!-- Beer -->
      <div class="cart-item">
        <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQoEBWmSWjmsV8d3wZ0OePhiO9myLJTNfCeDA&s" alt="Beer">
        <div class="item-details">
          <p class="item-name">Craft Beer Pack</p>
          <p class="item-price">$120.00</p>
        </div>
        <p class="item-qty">Qty: 2</p>
      </div>

      <!-- Shots -->
      <div class="cart-item">
        <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQgWNvTMaB2ynRosrfSPJ8rcU-a6bDKFCk_Sg&s" alt="Shots">
        <div class="item-details">
          <p class="item-name">Signature Shots</p>
          <p class="item-price">$80.00</p>
        </div>
        <p class="item-qty">Qty: 1</p>
      </div>

      <!-- Whiskey -->
      <div class="cart-item">
        <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQxAf5ieUSYCR8vayiViNuAVbuaIIpkDKPWfQ&s" alt="Whiskey">
        <div class="item-details">
          <p class="item-name">Aged Whiskey</p>
          <p class="item-price">$40.00</p>
        </div>
        <p class="item-qty">Qty: 1</p>
      </div>
    </div>

    <div class="summary">
      <h2>💳 Order Summary</h2>
      <p><span>Subtotal</span><span>$340.00</span></p>
      <p><span>Shipping</span><span>$10.00</span></p>
      <p><span>Tax (5%)</span><span>$17.00</span></p>
      <p class="total"><span>Total</span><span>$367.00</span></p>
    </div>

    <a href="/payment" style="text-decoration: none;">
      <button class="place-order">🚀 Place Order Now</button>
    </a>
  </div>

  <div class="footer">
    <p>&copy; 2025 <strong>BeBar</strong>. All rights reserved.</p>
    <p>
      <a href="/">Home</a> |
      <a href="/contact">Contact</a> |
      <a href="#">Privacy Policy</a> |
      <a href="#">Terms of Service</a>
    </p>
  </div>

</body>
</html>