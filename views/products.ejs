<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Products - Bar & Menu</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Alegreya', serif;
      background: url("https://themes.muffingroup.com/be/bar/wp-content/uploads/2015/02/home_bar_bg.png") repeat center center;
      color: #fff;
      padding: 20px;
      min-height: 100vh;
    }
    
    h1 { 
      text-align: center; 
      margin-bottom: 30px; 
      font-size: 2.5rem;
      text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
    }

    .filters-container {
      background-color: rgba(26, 26, 26, 0.9);
      padding: 25px;
      border-radius: 12px;
      max-width: 1200px;
      margin: 0 auto 30px auto;
      box-shadow: 0 4px 15px rgba(0,0,0,0.3);
    }

    .filters-form {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 15px;
      align-items: end;
    }

    .filter-group {
      display: flex;
      flex-direction: column;
      gap: 5px;
    }

    label { 
      font-weight: 600; 
      font-size: 0.9rem;
      color: #c49b63;
    }
    
    select, input[type="number"], button {
      padding: 10px 12px;
      border-radius: 6px;
      border: 1px solid #444;
      font-size: 1rem;
      font-family: inherit;
      background-color: #2a2a2a;
      color: #fff;
    }

    input[type="number"] {
      width: 100%;
    }

    input[type="number"]:focus, select:focus {
      outline: none;
      border-color: #c49b63;
    }

    button {
      background-color: #6b4423;
      color: #fff;
      cursor: pointer;
      transition: background-color 0.3s;
      border: none;
      font-weight: 600;
      height: fit-content;
    }
    button:hover { background-color: #c49b63; }

    .results-info {
      text-align: center;
      margin-bottom: 20px;
      color: #c49b63;
      font-size: 1.1rem;
    }

    .products {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
      gap: 25px;
      max-width: 1200px;
      margin: 0 auto 30px auto;
    }

    .product-card {
      background-color: #1a1a1a;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 4px 10px rgba(0,0,0,0.3);
      text-align: center;
      padding: 20px;
      transition: transform 0.3s, box-shadow 0.3s;
      border: 1px solid #333;
    }
    .product-card:hover {
      transform: translateY(-8px);
      box-shadow: 0 8px 25px rgba(0,0,0,0.6);
      border-color: #c49b63;
    }
    .product-card img {
      width: 100%;
      height: 200px;
      object-fit: cover;
      border-radius: 8px;
      margin-bottom: 15px;
      border: 2px solid #333;
    }
    .product-card h3 { 
      font-size: 1.3rem; 
      margin: 10px 0 8px; 
      color: #c49b63;
    }
    .product-card .category {
      font-size: 0.85rem;
      color: #999;
      margin-bottom: 8px;
      text-transform: uppercase;
      letter-spacing: 1px;
    }
    .product-card .price { 
      font-size: 1.5rem; 
      font-weight: bold;
      color: #fff;
      margin: 10px 0;
    }
    .product-card .description { 
      font-size: 0.95rem; 
      margin: 10px 0; 
      color: #ccc;
      line-height: 1.5;
    }

    .pagination {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 10px;
      margin: 40px 0;
      flex-wrap: wrap;
    }
    .pagination a, .pagination span {
      padding: 10px 16px;
      border-radius: 6px;
      text-decoration: none;
      background-color: #333;
      color: #fff;
      transition: background-color 0.2s;
      font-weight: 600;
      min-width: 44px;
      text-align: center;
    }
    .pagination a:hover { 
      background-color: #6b4423; 
      transform: scale(1.05);
    }
    .pagination .current { 
      background-color: #6b4423; 
      cursor: default;
    }
    .pagination .disabled {
      opacity: 0.5;
      cursor: not-allowed;
      pointer-events: none;
    }

    .error-message {
      background-color: rgba(220, 53, 69, 0.2);
      border: 1px solid #dc3545;
      color: #ff6b6b;
      padding: 15px;
      border-radius: 8px;
      text-align: center;
      margin: 20px auto;
      max-width: 600px;
    }

    .no-products {
      text-align: center;
      padding: 60px 20px;
      color: #999;
      font-size: 1.2rem;
    }

    @media (max-width: 768px) {
      h1 { font-size: 2rem; }
      .products { grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 20px; }
      .product-card img { height: 180px; }
      .filters-form { grid-template-columns: 1fr; }
    }
    @media (max-width: 480px) {
      .products { grid-template-columns: 1fr; gap: 15px; }
      .product-card img { height: 160px; }
      .product-card h3 { font-size: 1.1rem; }
      .product-card .price { font-size: 1.3rem; }
    }
  </style>
</head>
<body>

  <h1>🍺 Our Products</h1>

  <div style="text-align: center; margin-bottom: 20px;">
    <a href="/" style="display: inline-block; padding: 12px 24px; background-color: #6b4423; color: #fff; text-decoration: none; border-radius: 6px; font-weight: 600; transition: background-color 0.3s;">
      ← Back to Home
    </a>
  </div>

  <div class="filters-container">

  <div class="filters-container">
    <form method="GET" action="/products" class="filters-form" id="filterForm">
      <div class="filter-group">
        <label for="category">Category:</label>
        <select name="category" id="category">
          <option value="">All Categories</option>
          <% (categories || []).forEach(cat => { %>
            <option value="<%= cat %>" <%= (category || '') === cat ? "selected" : "" %>><%= cat %></option>
          <% }) %>
        </select>
      </div>

      <div class="filter-group">
        <label for="minPrice">Min Price ($):</label>
        <input type="number" name="minPrice" id="minPrice" min="0" step="0.01" value="<%= minPrice || '' %>" placeholder="0">
      </div>

      <div class="filter-group">
        <label for="maxPrice">Max Price ($):</label>
        <input type="number" name="maxPrice" id="maxPrice" min="0" step="0.01" value="<%= maxPrice || '' %>" placeholder="No limit">
      </div>

      <div class="filter-group">
        <label for="limit">Items per page:</label>
        <select name="limit" id="limit">
          <option value="10" <%= limit == 10 ? "selected" : "" %>>10</option>
          <option value="20" <%= limit == 20 ? "selected" : "" %>>20</option>
          <option value="30" <%= limit == 30 ? "selected" : "" %>>30</option>
          <option value="50" <%= limit == 50 ? "selected" : "" %>>50</option>
        </select>
      </div>

      <button type="submit">Apply Filters</button>
      <button type="button" onclick="resetFilters()">Reset</button>
    </form>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="error-message">
      <%= error %>
    </div>
  <% } %>

  <% if (products && products.length > 0) { %>
    <div class="results-info">
      Showing <%= products.length %> of <%= totalProducts %> products
      <% if (category) { %> • Category: <%= category %><% } %>
      <% if (minPrice || maxPrice) { %> • Price: $<%= minPrice || 0 %> - <%= maxPrice || '∞' %><% } %>
    </div>

    <div class="products">
      <% products.forEach(product => { %>
        <div class="product-card">
          <img src="<%= product.image || 'https://images.unsplash.com/photo-1554866585-cd94860890b7?w=400' %>" alt="<%= product.name %>" onerror="this.src='https://images.unsplash.com/photo-1554866585-cd94860890b7?w=400'">
          <div class="category"><%= product.category %></div>
          <h3><%= product.name %></h3>
          <div class="price">$<%= product.price.toFixed(2) %></div>
          <p class="description"><%= product.description %></p>
        </div>
      <% }) %>
    </div>

    <% if (totalPages > 1) { %>
      <div class="pagination">
        <% if (currentPage > 1) { %>
          <a href="<%= buildQueryString(currentPage - 1) %>">« Prev</a>
        <% } else { %>
          <span class="disabled">« Prev</span>
        <% } %>

        <% 
          let startPage = Math.max(1, currentPage - 2);
          let endPage = Math.min(totalPages, currentPage + 2);
          
          if (startPage > 1) { %>
            <a href="<%= buildQueryString(1) %>">1</a>
            <% if (startPage > 2) { %>
              <span>...</span>
            <% } %>
        <% } %>

        <% for (let i = startPage; i <= endPage; i++) { %>
          <% if (i === currentPage) { %>
            <span class="current"><%= i %></span>
          <% } else { %>
            <a href="<%= buildQueryString(i) %>"><%= i %></a>
          <% } %>
        <% } %>

        <% if (endPage < totalPages) { %>
          <% if (endPage < totalPages - 1) { %>
            <span>...</span>
          <% } %>
          <a href="<%= buildQueryString(totalPages) %>"><%= totalPages %></a>
        <% } %>

        <% if (currentPage < totalPages) { %>
          <a href="<%= buildQueryString(currentPage + 1) %>">Next »</a>
        <% } else { %>
          <span class="disabled">Next »</span>
        <% } %>
      </div>
    <% } %>
  <% } else { %>
    <div class="no-products">
      <p>No products found matching your criteria.</p>
      <p style="margin-top: 10px; font-size: 0.9rem;">Try adjusting your filters or <a href="/products" style="color: #c49b63;">view all products</a>.</p>
    </div>
  <% } %>

  <script>
    function resetFilters() {
      window.location.href = '/products';
    }
  </script>

</body>
</html>
